# ══════════════════════════════════════════════════════════════════════════════
# Terraform — State, Plans, Locks, and Backend Files
# ══════════════════════════════════════════════════════════════════════════════

# Terraform state files (always local-only, never commit)
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*.backup
crash.log
crash.*.log

# Terraform directory (downloaded provider plugins, modules)
.terraform/
.terraform.lock.hcl

# Terraform variable files (may contain sensitive data)
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (generated by CI/CD, should not commit)
*.tfplan
*.tfplan.json
*.plan

# Terraform cloud/enterprise
.terraformrc
terraform.rc

